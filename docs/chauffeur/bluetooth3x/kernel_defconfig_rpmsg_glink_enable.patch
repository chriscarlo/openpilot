diff --git a/arch/arm64/configs/tici_defconfig b/arch/arm64/configs/tici_defconfig
index 0000000..0000000 100644
--- a/arch/arm64/configs/tici_defconfig
+++ b/arch/arm64/configs/tici_defconfig
@@
# Bluetooth core and QCA helpers (already enabled in our branch)
# CONFIG_BT is not set
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_QCA=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y

# Qualcomm interconnect and shared memory (ensure available)
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD=y
CONFIG_QCOM_SMP2P=y

# RPMSG and Qualcomm GLINK transport (needed to enumerate GLINK endpoints)
CONFIG_RPMSG=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_PKT=y

# Optional debug knobs (if available in this tree) to aid bring-up
# CONFIG_RPMSG_QCOM_GLINK_LOGGING=y
# CONFIG_DEBUG_FS=y

+static int qca_recv_event(struct hci_dev *hdev, struct sk_buff *skb)
+{
+    struct hci_event_hdr *hdr = (void *)skb->data;
+    struct hci_uart *hu = hci_get_drvdata(hdev);
+    struct qca_data *qca = hu ? hu->priv : NULL;
+
+    if (skb->len >= sizeof(*hdr)) {
+        /* Vendor-specific event code is 0xFF */
+        if (hdr->evt == 0xFF && hdr->plen >= sizeof(struct edl_event_hdr) &&
+            skb->len >= sizeof(*hdr) + hdr->plen) {
+            struct edl_event_hdr *edl = (void *)(skb->data + sizeof(*hdr));
+            /* When drop window is open, swallow the baud-change event and
+             * signal completion to the setter.
+             */
+            if (qca && qca->drop_baud_evt &&
+                edl->rtype == EDL_SET_BAUDRATE_RSP_EVT) {
+                BT_DBG("Dropping QCA baudrate-change vendor event (0x92)");
+                qca->drop_baud_evt = false;
+                complete_all(&qca->drop_ev_comp);
+                kfree_skb(skb);
+                return 0;
+            }
+        }
+    }
+
+    return hci_recv_frame(hdev, skb);

{
  "hooks": {
    "UserPromptSubmit": {
      "command": "bash",
      "args": ["${CLAUDE_SETTINGS_DIR}/hooks/prompt_inject.sh"],
      "timeout": 5000
    },
    "SessionStart": {
      "command": "bash",
      "args": ["${CLAUDE_SETTINGS_DIR}/hooks/session_start.sh"],
      "timeout": 5000
    },
    "PreToolUse": [
      {
        "command": "python3",
        "args": ["${CLAUDE_SETTINGS_DIR}/hooks/track_read.py"],
        "filter": { "tool": "Read" },
        "timeout": 3000
      },
      {
        "command": "python3",
        "args": ["${CLAUDE_SETTINGS_DIR}/hooks/check_edit_read.py"],
        "filter": { "tool": ["Edit", "MultiEdit", "Write"] },
        "timeout": 3000
      }
    ],
    "PostToolUse": [
      {
        "command": "python3",
        "args": ["${CLAUDE_SETTINGS_DIR}/hooks/run_linters.py"],
        "filter": { "tool": ["Edit", "MultiEdit", "Write"] },
        "timeout": 10000
      }
    ]
  }
}